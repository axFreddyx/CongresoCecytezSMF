{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name_article": {
      "type": "string",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "users_id": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "article"
    },
    "accepted": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "work_table": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::work-table.work-table",
      "inversedBy": "article"
    }
  }
}
