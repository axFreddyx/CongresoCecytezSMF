{
  "kind": "collectionType",
  "collectionName": "receipts",
  "info": {
    "singularName": "receipt",
    "pluralName": "receipts",
    "displayName": "Receipt"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "invoice": {
      "type": "biginteger",
      "required": true
    },
    "paid": {
      "type": "decimal",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "validated": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "user_validator": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "isRejected": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "validated"
            },
            true
          ]
        }
      },
      "required": true,
      "default": false
    }
  }
}
